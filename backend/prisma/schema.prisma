// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(USER)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  USER
  ACCOUNTANT
}

model Company {
  id        String    @id @default(uuid())
  name      String
  pib       String    @unique
  address   String
  city      String
  phone     String?
  email     String
  users     User[]
  clients   Client[]
  invoices  Invoice[]
  expenses  Expense[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("companies")
}

model Client {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  name        String
  pib         String?
  address     String
  city        String
  phone       String?
  email       String?
  invoices    Invoice[]
  // Nove relacije za Agency Management
  clientUsers ClientUser[]
  tasks       Task[]
  files       ClientFile[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("clients")
}

model Invoice {
  id          String          @id @default(uuid())
  number      String          @unique
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  date        DateTime
  dueDate     DateTime
  items       InvoiceItem[]
  totalAmount Decimal         @db.Decimal(10, 2)
  paidAmount  Decimal         @default(0) @db.Decimal(10, 2)
  status      InvoiceStatus   @default(PENDING)
  payments    Payment[]
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(10, 2)
  price       Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  paymentDate DateTime
  method      PaymentMethod
  notes       String?
  createdAt   DateTime      @default(now())

  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

model Expense {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id])
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("expenses")
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MATERIALS
  MARKETING
  TRANSPORT
  OTHER
}

// ============================================
// AGENCY MANAGEMENT - Novi modeli
// ============================================

// Korisnici klijentske firme (loguju se u Client Hub)
model ClientUser {
  id        String         @id @default(uuid())
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email     String         @unique
  password  String
  firstName String
  lastName  String
  role      ClientUserRole @default(MEMBER)
  avatar    String?
  isActive  Boolean        @default(true)
  lastLogin DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("client_users")
}

enum ClientUserRole {
  OWNER  // Glavni kontakt - može sve
  MEMBER // Može dodavati taskove i komentare
  VIEWER // Samo pregled
}

// Taskovi - direktno vezani za klijenta (Kanban)
model Task {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  // Ko je kreirao task
  createdById   String
  createdByType String      // "ADMIN" ili "CLIENT"
  
  // Osnovni podaci
  title         String
  description   String?
  serviceType   ServiceType
  deadline      DateTime?
  
  // Kanban
  status        TaskStatus  @default(BACKLOG)
  position      Int         @default(0)
  
  // Relacije
  comments      Comment[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("tasks")
}

// 6 Kanban kolona
enum TaskStatus {
  ONBOARDING
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
  ARCHIVE
}

// Vrste servisa koje agencija pruža
enum ServiceType {
  BRANDING
  LOGO_DESIGN
  WEB_DESIGN
  UI_UX
  WEBFLOW_DEV
  SOCIAL_MEDIA
  PITCH_DECK
  MOTION_GRAPHICS
  ILLUSTRATIONS
  PRINT_DESIGN
  OTHER
}

// Komentari na taskovima
model Comment {
  id            String              @id @default(uuid())
  taskId        String
  task          Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  // Autor može biti Admin ili ClientUser
  authorId      String
  authorType    String              // "ADMIN" ili "CLIENT"
  authorName    String              // Cached ime za prikaz
  
  content       String?             // Tekst komentara
  attachments   CommentAttachment[]
  
  // Reply sistem
  parentId      String?
  parent        Comment?            @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]           @relation("CommentReplies")
  
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("comments")
}

// Fajlovi priloženi uz komentare
model CommentAttachment {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  fileName  String   // Originalno ime fajla
  filePath  String   // Putanja na serveru
  fileType  String   // MIME type
  fileSize  Int      // Veličina u bajtovima
  
  createdAt DateTime @default(now())

  @@map("comment_attachments")
}

// Fajlovi klijenta (zasebni od komentara)
model ClientFile {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  uploaderId   String
  uploaderType String   // "ADMIN" ili "CLIENT"
  
  fileName     String   // Originalno ime
  filePath     String   // Putanja na serveru
  mimeType     String
  fileSize     Int      // Bytes
  
  createdAt    DateTime @default(now())

  @@map("client_files")
}
